	<queryString language="SQL">
		<![CDATA[SELECT
                CAST(c.id_cita AS CHAR) AS cita_id,
                DATE_FORMAT(
                    c.fecha_hora,
                    '%d/%m/%Y %H:%i'
                ) AS fecha,
                CAST(c.id_mascota AS CHAR) AS mascota_id,
                CAST(c.id_servicio AS CHAR) AS servicio_id,
                COALESCE(c.estado, '') AS estado,
                COALESCE(c.motivo, '') AS motivo,
                COALESCE(c.observaciones, '') AS observaciones
            FROM tbl_cita c
            ORDER BY c.fecha_hora DESC, c.id_cita DESC]]>
	</queryString>
	<field name="cita_id" class="java.lang.String"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="mascota_id" class="java.lang.String"/>
	<field name="servicio_id" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="motivo" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<variable name="TOTAL_CITAS" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{cita_id}]]></variableExpression>
	</variable>
